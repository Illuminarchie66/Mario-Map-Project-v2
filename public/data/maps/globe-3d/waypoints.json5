		displayType: "pamphlet",

		content: {
			left: [
				{
					type: "header",
					title: "Metro Kingdom",
					tagline: "The Big Banana",
					image: "header.png",
				},		
				{
					type: "appeared-table",
					firstAppeared: {
						game: "Donkey Kong",
						year: 1981,
						link: "https://www.mariowiki.com/Donkey_Kong_(game)"
					},

						},
						{
							image: "diamond_city.jpg",
							caption: "Diamond City"
						},
						{
							image: "dry_dry_desert.webp",
							caption: "Dry Dry Desert"
						}
					]
				},
				{
					type: "spacer"
				},
				{
					type: "image-bottom",
					image: "nsmb_hills.jpg",
					height: "150px"
				}
			]
		},

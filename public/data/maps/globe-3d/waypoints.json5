				{
					type: "horizontal-rule",
				},
				{
					type: "text",
					title: "Awazon River Basin",
					titleColor: "#b18f01",
					content: "A large central river that flows through the jungles of Cascade Kingdom. Wario visited here for the events of Virtual Boy Wario Land, taking a vacation before the Aldegara Waterfall. Deep underground there are many masked creatures hoarding treasures, and hiding the Realm of the Demon Head.",
					alignContent: "left",
				},
				{
					type: "image",

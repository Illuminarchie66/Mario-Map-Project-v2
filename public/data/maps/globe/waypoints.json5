					images: [
						{
							image: "city_hall.jpg",
							caption: "Mayor Pauline outside New Donk City Hall"
						},
						{
							image: "crazy_cap.webp",
							caption: "Crazy Cap Store"
						},
						{
							image: "power_plant.png",
							caption: "New Donk City Power Plant"
						},
					]
				},
			],

			right: [

					type: "horizontal-rule",
				},
				{
					type: "text",
					title: "Petal Meadows",
					titleColor: "#b18f01",
					content: "A pleasant plateau surrounded by hills to the East of Rogueport.  Here you can stop in one of the adorable Koopa towns such as Petalburg or Windmillville! Just on the horizon you will make out the dreaded Hooktail Castle.",
					alignContent: "left",
				},
				{
					type: "carousel",
					images: [
						{
							image: "petal_meadows.webp",
							caption: "Petal Meadows"

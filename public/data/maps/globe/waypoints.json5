	{
		id: "cascade-kingdom",
		coords: [-44.5, -85],
		
		label: "Cascade Kingdom",
		icon: "default",
		path: "data/maps/globe/assets/waypoints/cascade-kingdom/",

		displayType: "pamphlet",

		content: {
			left: [
				{
					type: "header",
					title: "Cascade Kingdom",
					tagline: "Home of Prehistory",
					image: "header.png",
				},		
				{
					type: "appeared-table",
					firstAppeared: {
						game: "Super Mario World",
						year: 2001,
						link: "https://www.mariowiki.com/Super_Mario_World:_Super_Mario_Advance_2"
					},
					lastAppeared: {
						game: "Paper Mario: The Thousand-Year Door (Nintendo Switch)",
						year: 2024,
						link: "https://www.mariowiki.com/Paper_Mario:_The_Thousand-Year_Door_(Nintendo_Switch)"
					}
				},
				{
					type: "text",
					content: "Vibrant greens! Rushing streams! Giant dinosaurs! Cascade Kingdom is an idyllic paradise of the past, with a slew of  prehistoric reptiles roaming the fields. Adorning the grassy mountains are fossilised remains of those that once resided here and vast rushing rivers and waterfalls. Whether you visit the imposing Fossil Falls, the mystical Aldegara Waterfall, the enchanting Fairy Forest, or just chill with the Yoshis, you will remember this trip for life.",
					alignContent: "left",
				},
				{
					type: "horizontal-rule",
				},
				{
					type: "image-right",
					title: "Fossil Falls",
					titleColor: "#b18f01",
					titleOnTop: true,
					image: "fossil_falls_concept.jpg",
					caption: "Fossil Falls Concept Art",
					content: "The central landmark of the triceratops-shaped landmass, is an impressive display of the enormity of the Kingdom. Connected to the Cap Kingdom by a spark pylon, the kingdom has strange ruins of airships Bonneters once flew. One of these ruins becomes the iconic ship The Odyssey. Here you can find the intimidating T-Rexes snoozing in the sun."
				},
				{
					type: "image",
					alignImage: "center",
					image: "fossil_falls.webp",
					caption: "Fossil Falls",
					alignCaption: "center",
				},
				{
					type: "horizontal-rule",
				},
				{
					type: "text",
					title: "Awazon River Basin",
					titleColor: "#b18f01",
					content: "A large central river that flows through the jungles of Cascade Kingdom. Wario visited here for the events of Virtual Boy Wario Land, taking a vacation before the Aldegara Waterfall. Deep underground there are many masked creatures hoarding treasures, and hiding the Realm of the Demon Head.",
					alignContent: "left",
				},
				{
					type: "image",
					alignImage: "center",
					image: "awazon_river.png",
					caption: "Wario looking at the Aldegara Waterfall",
					alignCaption: "center",
				},
			],

			right: [
				{
					type: "text",
					title: "Dinosaur Land",
					titleColor: "#b18f01",
					content: "Off the coast of the main continent is a small archipelago inhabited by many dinosaurs, most famously Yoshi! Here you will find a host of creatures including Blarggs, dino-Rhinos, Dino-Torches, Eeries, Rexes and Reznors. In Super Mario World, this is the vacation spot of Mario and his friends.",
					alignContent: "left",
				},
				{
					type: "image",
					alignImage: "center",
					image: "dinosaur_land.webp",
					caption: "Dinosaur Land Map",
					alignCaption: "center",
				},
				{
					type: "horizontal-rule",
					color: "#b18f01"
				},
				{
					type: "image-right",
					title: "Fairy Forest",
					titleColor: "#b18f01",
					titleOnTop: false,
					image: "wanda.png",
					imageWidth: "250px",
					caption: "Wanda the Fairy",
					content: "Deep within the forest depths, not too far from the Sprixie Kingdom, lies the magical Fairy Forest. Here  Wanda resides, and helps Mario against Wario's escapades. "
				},
				{
					type: "text",
					content: "Wanda joins them on their adventures across the Cascade Kingdom. This includes Yos Lake, the rumored to be the origin of Yoshis. There is also Cloud-Catching Mountain, the Ice and Flame Caverns, and the Cheep Cheep Sea.",
					alignContent: "left",
				},
				{
					type: "carousel",
					images: [
						{
							image: "fairy_forest.png",
							caption: "Fairy Forest"
						},
						{
							image: "yos_lake.png",
							caption: "Yos Lake"
						},
						{
							image: "cloudcatching.png",
							caption: "Cloud Catching Mountain"
						},
						{
							image: "ice_cavern.png",
							caption: "Ice Caverns"
						},
						{
							image: "fire_cavern.png",
							caption: "Fire Caverns"
						},
						{
							image: "cheep_cheep_sea.png",
							caption: "Cheep Cheep Sea"
						}
					]
				},
				{
					type: "horizontal-rule",
					color: "#b18f01"
				},
				{
					type: "image-right",
					title: "Keelhaul Key",
					titleColor: "#b18f01",
					titleOnTop: true,
					image: "keelhaul.jpg",
					caption: "Keelhaul Key",
					content: "A tropical jungle island to the South of Rogueport, off the coast of the Cascade Kingdom. The isle is said to be deserted and cursed. A small shantytown has been built by pirates searching for treasure just outside of the dense jungle. If you search hard enough, you might just find the Pirate's Grotto, and Cortez's legendary ship: the Black Skull. "
				},
			]
		}

	},

